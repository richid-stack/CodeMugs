# Copy to .env for local development. Never commit .env.
# Only variables the code actually reads are listed here.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

# The worker needs both. Use the real roles' logins (see infrastructure/database/README.md);
# they must be different logins, and neither may be a superuser.
# DATABASE_URL=postgres://codemugs_app:<password>@127.0.0.1:5432/codemugs
# DISPATCHER_DATABASE_URL=postgres://codemugs_dispatcher:<password>@127.0.0.1:5432/codemugs
