# Copy to .env for local development. Never commit .env.
# Only variables the code actually reads are listed here.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

# The worker needs both. Use the real roles' logins (see infrastructure/database/README.md);
# they must be different logins, and neither may be a superuser.
# DATABASE_URL=postgres://codemugs_app:<password>@127.0.0.1:5432/codemugs
# DISPATCHER_DATABASE_URL=postgres://codemugs_dispatcher:<password>@127.0.0.1:5432/codemugs

# The process that analyses repositories (apps/analysis-worker) needs the two logins above, the three
# GitHub App settings below (CODEMUGS_GITHUB_APP_ID, _CLIENT_ID and _PRIVATE_KEY, but no installation:
# the installation comes from each project's connection) and a sandbox. It refuses to start without
# a sandbox that runs and isolates at least as much as asked, and it has no default for any of these.
# It reads each of them, then removes the secrets from its own environment.
# ANALYSIS_SANDBOX_DRIVER=docker                       # docker or gvisor
# ANALYSIS_SANDBOX_MINIMUM_ISOLATION=hardened-container # hardened-container, gvisor or microvm
# ANALYSIS_SANDBOX_IMAGE=<name>@sha256:<64 hex digits>  # a Node 22 image, pinned by digest
# ANALYSIS_WORKSPACE_ROOT=/var/lib/codemugs/analysis    # an absolute path to a folder it may write to
# WORKER_CONCURRENCY=1                                   # 1 to 8 here; each analysis holds 1 CPU and 1 GiB
# WORKER_LEASE_SECONDS=600                               # at least 450, which is longer than the longest analysis

# The migration command needs a third login, for the migration role: it owns the tables and may
# create them, and it is never the application or dispatcher role. Run it with `pnpm db:migrate`.
# MIGRATION_DATABASE_URL=postgres://<migration role>:<password>@127.0.0.1:5432/codemugs

# The GitHub App check (integrations/github) reads these. It normally runs in GitHub Actions from
# main, where the private key is an environment secret and none of this is needed. Put the key
# here only to run the check by hand, never commit it, and use the .pem file's contents (a client
# secret is not the key).
# CODEMUGS_GITHUB_APP_ID=
# CODEMUGS_GITHUB_APP_CLIENT_ID=
# CODEMUGS_GITHUB_APP_INSTALLATION_ID=
# CODEMUGS_GITHUB_APP_PRIVATE_KEY=
# GITHUB_REPOSITORY=<owner>/<name>
