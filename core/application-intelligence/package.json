{
  "name": "@codemugs/application-intelligence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./analyser": {
      "types": "./dist/analyser.d.ts",
      "default": "./dist/analyser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codemugs/archive": "workspace:*",
    "@codemugs/sandbox-manager": "workspace:*",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
